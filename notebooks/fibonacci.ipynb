    "def add(a, b):\n",
    "    return a + b\n",
    "\n",
    "def fibonacci(n):\n",
    "    a, b = 0, 1\n",
    "    for i in range(n):\n",
    "        a, b = b, add(a, b)\n",
    "    return a\n"
